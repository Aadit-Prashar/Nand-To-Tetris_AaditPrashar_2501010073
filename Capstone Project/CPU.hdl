CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:

    // A-register input selection
    Not(in=instruction[15], out=isA);

    Mux16(a=aluOut, b=instruction, sel=isA, out=inA);

    // A-register load control
    Or(a=isA, b=instruction[5], out=loadA);

    ARegister(in=inA, load=loadA, out=A, out[0..14]=addressM);

    // ALU input selection (A or M)
    And(a=instruction[15], b=instruction[12], out=selAM);
    Mux16(a=A, b=inM, sel=selAM, out=aluY);

    // D-register
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=D);

    // ALU
    ALU(
        x=D,
        y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zr,
        ng=ng
    );

    // Memory write
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump logic
    Or(a=zr, b=ng, out=zrOrNg);
    Not(in=zrOrNg, out=pos);

    And(a=instruction[0], b=pos, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);

    Or(a=jgt, b=jeq, out=jge);
    Or(a=jge, b=jlt, out=jumpCond);
    And(a=instruction[15], b=jumpCond, out=loadPC);

    // Program Counter
    PC(in=A, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}